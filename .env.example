# Clé API Gemini (Obligatoire)
# Obtenez-en une gratuitement sur : https://aistudio.google.com/apikey
GEMINI_API_KEY=votre_cle_ici

# Modèle Gemini à utiliser
GEMINI_MODEL=models/gemini-3.1-flash-lite

# Persona choisi lors de l'installation
# Valeurs : developer, student, creative, manager, streamer, custom
OMI_PERSONA=developer

# Objectif principal d'OMI (généré automatiquement selon le persona, ou personnalisé)
# Vous pouvez modifier ce texte librement pour affiner le comportement d'OMI
OMI_OBJECTIVE=L'utilisateur est développeur. Tu dois surveiller son code en permanence : détecter les erreurs, bugs, et mauvaises pratiques dès qu'ils apparaissent à l'écran. Propose des corrections concrètes et courtes.
